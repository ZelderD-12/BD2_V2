.PHONY: dev stop clean start db-export db-import db-restore-all restaurarbd docker-up docker-down docker-restart

# Detectar sistema operativo
ifeq ($(OS),Windows_NT)
    KILL_BUN = @taskkill /F /IM bun.exe 2>nul || true
    KILL_NODE = @taskkill /F /IM node.exe 2>nul || true
    DOWNLOADS = C:/Users/$(USERNAME)/Downloads
    IMPORT_DIR = sql/import
else
    KILL_BUN = @pkill bun 2>/dev/null || true
    KILL_NODE = @pkill node 2>/dev/null || true
    DOWNLOADS = $(HOME)/Downloads
    IMPORT_DIR = sql/import
endif

DB_CONTAINER = clinica_sqlserver
DB_USER = sa
DB_PASSWORD = ClinicaDBgrupo3\#
DB_NAME = ClinicaF
SQLCMD = /opt/mssql-tools18/bin/sqlcmd
DATE = $(shell powershell -Command "Get-Date -Format 'yyyyMMdd_HHmmss'")

dev:
	@echo 🧹 Limpiando procesos anteriores...
	$(KILL_BUN)
	$(KILL_NODE)
	@echo 🚀 Iniciando servicios...
	@bun run dev

stop:
	@echo 🔴 Deteniendo servicios...
	$(KILL_BUN)
	$(KILL_NODE)
	@echo ✅ Servicios detenidos

start: stop dev

# Exportar base de datos (ClinicaF + ClinicaF_DW)
db-export:
	@echo 📦 Exportando ClinicaF...
	@docker exec -it $(DB_CONTAINER) $(SQLCMD) -S localhost -U $(DB_USER) -P "$(DB_PASSWORD)" -C -Q "BACKUP DATABASE [ClinicaF] TO DISK = N'/var/opt/mssql/backup/ClinicaF.bak'"
	@echo 📦 Exportando ClinicaF_DW...
	@docker exec -it $(DB_CONTAINER) $(SQLCMD) -S localhost -U $(DB_USER) -P "$(DB_PASSWORD)" -C -Q "BACKUP DATABASE [ClinicaF_DW] TO DISK = N'/var/opt/mssql/backup/ClinicaF_DW.bak'"
	@echo ✅ Backups creados en el contenedor
	@mkdir -p sql/export 2>nul || true
	@docker cp $(DB_CONTAINER):/var/opt/mssql/backup/ClinicaF.bak "./sql/export/ClinicaF.bak"
	@docker cp $(DB_CONTAINER):/var/opt/mssql/backup/ClinicaF.bak "./sql/export/ClinicaF_$(DATE).bak"
	@docker cp $(DB_CONTAINER):/var/opt/mssql/backup/ClinicaF_DW.bak "./sql/export/ClinicaF_DW.bak"
	@docker cp $(DB_CONTAINER):/var/opt/mssql/backup/ClinicaF_DW.bak "./sql/export/ClinicaF_DW_$(DATE).bak"
	@echo ✅ Backups guardados en: sql/export/

# Importar base de datos desde sql/export/
db-import:
	@echo 📋 Restaurando ClinicaF...
	@docker cp "./sql/export/ClinicaF.bak" $(DB_CONTAINER):/var/opt/mssql/backup/restore_f.bak 2>$null
	@docker exec -it $(DB_CONTAINER) $(SQLCMD) -S localhost -U $(DB_USER) -P "$(DB_PASSWORD)" -C -Q "RESTORE DATABASE [ClinicaF] FROM DISK = N'/var/opt/mssql/backup/restore_f.bak' WITH REPLACE, RECOVERY"
	@echo 📋 Restaurando ClinicaF_DW...
	@docker cp "./sql/export/ClinicaF_DW.bak" $(DB_CONTAINER):/var/opt/mssql/backup/restore_dw.bak 2>$null
	@docker exec -it $(DB_CONTAINER) $(SQLCMD) -S localhost -U $(DB_USER) -P "$(DB_PASSWORD)" -C -Q "RESTORE DATABASE [ClinicaF_DW] FROM DISK = N'/var/opt/mssql/backup/restore_dw.bak' WITH REPLACE, RECOVERY"
	@echo ✅ Bases de datos restauradas

# Importar desde Downloads
db-import-downloads:
	@echo 📥 Restaurando ClinicaF desde Downloads...
	@docker cp "$(DOWNLOADS)/ClinicaF.bak" $(DB_CONTAINER):/var/opt/mssql/backup/restore_f.bak
	@docker exec -it $(DB_CONTAINER) $(SQLCMD) -S localhost -U $(DB_USER) -P "$(DB_PASSWORD)" -C -Q "RESTORE DATABASE [ClinicaF] FROM DISK = N'/var/opt/mssql/backup/restore_f.bak' WITH REPLACE, RECOVERY"
	@echo 📥 Restaurando ClinicaF_DW desde Downloads...
	@docker cp "$(DOWNLOADS)/ClinicaF_DW.bak" $(DB_CONTAINER):/var/opt/mssql/backup/restore_dw.bak
	@docker exec -it $(DB_CONTAINER) $(SQLCMD) -S localhost -U $(DB_USER) -P "$(DB_PASSWORD)" -C -Q "RESTORE DATABASE [ClinicaF_DW] FROM DISK = N'/var/opt/mssql/backup/restore_dw.bak' WITH REPLACE, RECOVERY"
	@echo ✅ Bases de datos restauradas

# Restaurar todas las BDs desde sql/backup/
db-restore-all: restaurarbd
restaurarbd:
	@echo 🔄 Restaurando todas las bases de datos desde sql/backup/...
	@docker cp scripts/restore-all.sh $(DB_CONTAINER):/tmp/restore-all.sh
	@docker cp sql/migrate $(DB_CONTAINER):/tmp/migrate 2>nul || echo "   Sin migraciones"
	@docker exec $(DB_CONTAINER) bash /tmp/restore-all.sh
	@echo ✅ Restauracion completada

# Docker - levanta SQL Server + Backend en contenedores
docker-up:
	@docker-compose up -d --build
	@echo ⏳ Esperando que el backend inicie...
	@timeout /t 5 /nobreak >nul
	@echo ✅ Backend en http://localhost:${BACKEND_PORT:-8080}
	@echo ✅ SQL Server en localhost:${SQLSERVER_PORT:-1436}

# Docker + frontend local (flujo completo)
docker-dev: docker-up
	@echo 🚀 Iniciando frontend local...
	@bun run --filter frontend dev

docker-down:
	@docker-compose down

docker-restart: docker-down docker-up

# Frontend local (asume que el backend ya está en Docker o en línea)
dev-frontend:
	@echo 🚀 Iniciando frontend...
	@bun run --filter frontend dev